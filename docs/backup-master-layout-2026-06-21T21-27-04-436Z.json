  "contenu_html": "<!DOCTYPE html>\r\n<html lang=\"fr\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\r\n</head>\r\n<body style=\"margin:0;padding:0;background-color:#0f1e38;background-image:radial-gradient(ellipse 70% 60% at 12% 75%,rgba(74,144,217,0.55) 0%,transparent 100%),radial-gradient(ellipse 55% 55% at 82% 12%,rgba(138,92,246,0.45) 0%,transparent 100%),radial-gradient(ellipse 50% 45% at 58% 92%,rgba(16,185,129,0.30) 0%,transparent 100%);\">\r\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#0f1e38;background-image:radial-gradient(ellipse 70% 60% at 12% 75%,rgba(74,144,217,0.55) 0%,transparent 100%),radial-gradient(ellipse 55% 55% at 82% 12%,rgba(138,92,246,0.45) 0%,transparent 100%),radial-gradient(ellipse 50% 45% at 58% 92%,rgba(16,185,129,0.30) 0%,transparent 100%);\">\r\n  <tr><td align=\"center\" style=\"padding:32px 16px 48px;\">\r\n    <table cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:580px;width:100%;\">\r\n      <tr>\r\n        <td style=\"padding:0 0 0 50px;\">\r\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\r\n            <tr>\r\n              <td valign=\"top\" width=\"160\" style=\"line-height:0;\">\r\n                <a href=\"https://www.100000medecins.org\" style=\"text-decoration:none;display:inline-block;line-height:0;margin-bottom:-50px;position:relative;\">\r\n                  <img src=\"https://qnspmlskzgqrqtuvsbuo.supabase.co/storage/v1/object/public/images/logos/logo-principal-couleur-trimmed.png\" alt=\"100 000 Medecins\" width=\"140\" style=\"display:block;width:140px;height:auto;border:0;\" />\r\n                </a>\r\n              </td>\r\n              <td valign=\"bottom\" align=\"right\" style=\"padding:0 20px 6px 0;\">\r\n                <p style=\"margin:0;font-size:13px;font-weight:700;color:#FFFFFF;text-transform:uppercase;letter-spacing:1.5px;opacity:0.85;\">{{label}}</p>\r\n      